{
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "private"
          },
          {
            "ip_is_private": true
          }
        ],
        "outbound": "⚡ Direct"
      },
      {
        "protocol": "bittorrent",
        "outbound": "⚡ Direct"
      },
      {
        "rule_set": "google-gemini",
        "outbound": "✨ Gemini"
      },
      {
        "rule_set": "microsoft",
        "outbound": "Ⓜ Microsoft"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "cn"
          },
          {
            "rule_set": "geoip-cn"
          }
        ],
        "outbound": "⚡ Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": ["cn", "google-gemini", "microsoft", "private"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geosite/{tag}.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geoip/cn.srs"
      }
    ],
    "default_domain_resolver": "dns_ali",
    "default_http_client": "default-http-client",
    "final": "🚀 Default"
  }
}
